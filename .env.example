# Web client (Vite). Safe to expose — the anon key is public by design and RLS
# is what protects the data.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Turn on only after applying migration 0043_avatar_accessories.sql. Until
# then accessories remain a safe local preference and old schemas stay green.
VITE_AVATAR_ACCESSORIES_DB=false

# Edge Functions only. NEVER put this in the client bundle or commit it.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
