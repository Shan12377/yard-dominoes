{
  "name": "yard-dominoes",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "test": "node --test packages/engine/test/*.test.ts apps/web/src/*.test.ts supabase/functions/_shared/*.test.ts",
    "bench": "node packages/engine/bench.ts",
    "dev": "npm run dev --workspace @yard/web",
    "build": "npm run build --workspace @yard/web",
    "typecheck": "npm run typecheck --workspace @yard/web",
    "test:e2e": "npx playwright test --config apps/web/playwright.config.ts",
    "sync:engine": "rm -rf supabase/functions/_shared/engine && mkdir -p supabase/functions/_shared/engine && cp packages/engine/src/*.ts supabase/functions/_shared/engine/",
    "db:reset": "npx supabase db reset",
    "fn:serve": "npm run sync:engine && npx supabase functions serve",
    "fn:deploy": "npm run sync:engine && npx supabase functions deploy",
    "gen:avatars": "python3 scripts/gen_avatars.py",
    "gen:backgrounds": "python3 scripts/gen_backgrounds.py",
    "gen:reactions": "python3 scripts/gen_reactions.py",
    "gen:diagrams": "node scripts/gen-diagrams.ts"
  }
}
